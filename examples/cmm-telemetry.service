[Unit]
Description=Crypto Mesh Map Telemetry Agent (MeshCore Companion)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/cryptomeshmap-observer
Environment="CMM_OBSERVER_TOKEN=YOUR_OBSERVER_TOKEN"
ExecStart=/usr/bin/python3 /opt/cryptomeshmap-observer/meshcore-telemetry-agent.py --serial /dev/ttyUSB0 --interval 300
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
